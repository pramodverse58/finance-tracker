{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Backend (H2 - no DB install needed)",
      "request": "launch",
      "mainClass": "com.financetracker.FinanceTrackerApplication",
      "projectName": "finance-tracker-backend",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "SPRING_PROFILES_ACTIVE": "h2"
      }
    },
    {
      "type": "java",
      "name": "Backend (PostgreSQL)",
      "request": "launch",
      "mainClass": "com.financetracker.FinanceTrackerApplication",
      "projectName": "finance-tracker-backend",
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
